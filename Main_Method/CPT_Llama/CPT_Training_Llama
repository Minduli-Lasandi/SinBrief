}/Models/CPT_Llama_Model\" # Final HF model saved here\n","CHECKPOINT_PATH = f\"{BASE_PATH}/Models/CPT_Checkpoints\" # Per-epoch checkpoints\n","OUTPUT_PATH     = f\"{BASE_PATH}/Outputs\"\n","\n","# Create directories if they don't exist\n","os.makedirs(MODEL_SAVE_PATH, exist_ok=True)\n","os.makedirs(CHECKPOINT_PATH, exist_ok=True)\n","os.makedirs(OUTPUT_PATH, exist_ok=True)\n","\n","# Verify training data exists\n","assert os.path.exists(TRAIN_DATA_PATH), f\"Training data path not found: {TRAIN_DATA_PATH}\"\n","\n","# Count documents\n","doc_files = glob.glob(f\"{TRAIN_DATA_PATH}/*.txt\")\n","print(f\"Paths verified\")\n","print(f\"Found {len(doc_files)} training documents\")"],"metadata":{"id":"39JesOmT6JJ5","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1773583255619,"user_tz":-330,"elapsed":4726,"user":{"displayName":"spamMlacct","userId":"07376414315731557176"}},"outputId":"30d2be57-a5e1-49fe-c9a7-5209845bbcc4"},"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["Paths verified\n","Found 964 training documents\n"]}]},{"cell_type":"code","source":["print(\"Loading documents...\")\n","\n","all_texts = []\n","for filepath in doc_files:\n","    with open(filepath, 'r', encoding='utf-8') as f:\n","        text = f.read().strip()\n","        if len(text) > 0:\n","            all_texts.append(text)\n","\n","print(f\"Loaded {len(all_texts)} non-empty documents\")\n","print(f\"Sample document (first 200 chars):\\n{all_texts[0][:200]}...\")\n","\n","# Basic stats\n","lengths = [len(t) for t in all_texts]\n","print(f\"\\nDocument length stats:\")\n","print(f\"  Min:    {min(lengths)} chars\")\n","print(f\"  Max:    {max(lengths)} chars\")\n","print(f\"  Avg:    {int(sum(lengths)/len(lengths))} chars\")\n","print(f\"  Total:  {sum(lengths):,} chars\")\n"],"metadata":{"id":"zSsECac26L54","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1773583283561,"user_tz":-330