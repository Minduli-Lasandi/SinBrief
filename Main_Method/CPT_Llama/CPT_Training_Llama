 return len(self.chunks)\n","\n","    def __getitem__(self, idx):\n","        chunk = self.chunks[idx]\n","        input_ids = torch.tensor(chunk, dtype=torch.long)\n","        # For causal LM: labels = input_ids (predict next token)\n","        labels    = input_ids.clone()\n","        return {\n","            'input_ids': input_ids,\n","            'labels':    labels\n","        }\n","\n","print(\"Dataset class defined\")"],"metadata":{"id":"Y-Wh_1mH6Pjv","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1773583283564,"user_tz":-330,"elapsed":5,"user":{"displayName":"spamMlacct","userId":"07376414315731557176"}},"outputId":"c30aacfe-fc39-4555-c17b-b126f15b8915"},"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["Dataset class defined\n"]}]},{"cell_type":"code","source":["from huggingface_hub import notebook_login\n","notebook_login()\n","\n","MODEL_NAME = \"meta-llama/Meta-Llama-3.1-8B\"\n","\n","print(f\"Loading tokenizer for {MODEL_NAME}...\")\n","tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\n","tokenizer.pad_token = tokenizer.eos_token\n","\n","# Create dataset\n","dataset = CPTDataset(all_texts, tokenizer, chunk_size=CHUNK_SIZE)\n","\n","# Create dataloader\n","BATCH_SIZE = 4\n","dataloader = DataLoader(\n","    dataset,\n","    batch_size=BATCH_SIZE,\n","    shuffle=True,\n","    drop_last=True\n",")\n","\n","print(f\"\\nDataLoader ready:\")\n","print(f\"  Total chunks:  {len(dataset)}\")\n","print(f\"  Batch size:    {BATCH_SIZE}\")\n","print(f\"  Total batches: {len(dataloader)}\")"],"metadata":{"id":"LzKTkQ8g6SGQ","colab":{"base_uri":"https://localhost:8080/","height":648,"referenced_widgets":["3ce6f58559fa42dab929d09b4eb209e2","07d6882616074dfdb7ead64adcc3ed11","7ce3c6b357cc44659288cd873fdc6d43","e9ec50137f25480db4860a92e24a4591","973fc30427d7417199a9aa1757c8dccd","8264f1319f534dd795239da7f33a8f64","0563e2ae184145f4a8d5ef6460857230","20b611c3cfcb4bdd97ff3776544641ab","6dd899012