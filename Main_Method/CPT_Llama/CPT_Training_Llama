cheduler.step()\n","\n","        total_loss += loss.item()\n","        steps += 1\n","\n","        progress_bar.set_postfix({'loss': f'{loss.item():.4f}'})\n","\n","        # Mid-epoch checkpoint every 2000 batches\n","        if (batch_idx + 1) % checkpoint_interval == 0:\n","            mid_checkpoint_dir = f\"{checkpoint_path}/epoch_{epoch}_batch_{batch_idx + 1}\"\n","            print(f\"\\n  Saving mid-epoch checkpoint at batch {batch_idx + 1}...\")\n","            model.save_pretrained(mid_checkpoint_dir)\n","            tokenizer.save_pretrained(mid_checkpoint_dir)\n","            torch.save({\n","                'optimizer_state_dict': optimizer.state_dict(),\n","                'scheduler_state_dict': scheduler.state_dict(),\n","                'train_losses':         train_losses,\n","                'epoch':                epoch,\n","                'batch':                batch_idx + 1\n","            }, f\"{mid_checkpoint_dir}/optimizer.pt\")\n","            print(f\"  Mid-epoch checkpoint saved!\")\n","\n","    avg_loss = total_loss / steps if steps > 0 else 0\n","    return avg_loss\n","\n","print(\"Training function defined\")"],"metadata":{"id":"9HFg5xWJ6cqv","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1773583453855,"user_tz":-330,"elapsed":12,"user":{"displayName":"spamMlacct","userId":"07376414315731557176"}},"outputId":"005d53cf-2ffe-4ace-e800-6e26ab896fc5"},"execution_count":10,"outputs":[{"output_type":"stream","name":"stdout","text":["Training function defined\n"]}]},{"cell_type":"code","source":["# CELL 12 - Run training\n","# ============================================================\n","print(\"\\n\" + \"=\"*60)\n","print(\"STARTING CONTINUAL PRE-TRAINING - LLaMA 3.1 8B\")\n","print(\"=\"*60 + \"\\n\")\n","\n","best_loss = float('inf')\n","\n","for epoch in range(start_epoch, EPOCHS + 1):  # Changed start_epoch + 1 to start_epoch\n","    if epoch == 0:  # Skip epoch 0\n","        continue\n","